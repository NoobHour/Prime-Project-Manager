# Compose reads .env; plain Node launchers require shell environment variables.
# Keep a private data directory outside the repository.
# MGMT_DATA_DIR=/path/to/private/ppm-data
# MGMT_HOST=127.0.0.1
# MGMT_PORT=3333
MGMT_ORIGIN=http://localhost:3333
# Docker host port; set the matching MGMT_ORIGIN when changing this.
PPM_PORT=3333
# MGMT_DEMO_DATA_DIR=/path/to/disposable/demo-data

# Standalone compose.demo.yaml only; separate from the normal application.
# PPM_DEMO_PORT=3336
# PPM_DEMO_ORIGIN=http://localhost:3336
# PPM_DEMO_RESET_MINUTES=60
