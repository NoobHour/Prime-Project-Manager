# Deny unrelated workspace files; the source-manifest gate verifies all included files during build.
**
!apps/
!apps/**
!libs/
!libs/**
!tools/
!tools/**
!test/
!test/**
!docs/
!docs/**
!.github/
!.github/**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!angular.json
!tsconfig.base.json
!proxy.conf.json
!.prettierrc
!.gitignore
!.gitattributes
!.env.example
!README.md
!LICENSE
!CONTRIBUTING.md
!SECURITY.md
!THIRD_PARTY_NOTICES.md
!SOURCE-MANIFEST.json
!Dockerfile
!compose.yaml
!.dockerignore
# Private artifacts are excluded even if someone places them beneath a source directory.
**/node_modules/**
**/.git/**
**/.env
**/.env.*
!**/.env.example
!.env.example
**/*.sqlite*
**/*.db
**/*.key
**/*.pem
**/*.pfx
**/session-key
**/*.zip
**/*.log
**/uploads/**
**/backups/**
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.ico

!compose.demo.yaml
